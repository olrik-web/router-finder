{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "Generate": {
      "PermitLimit": 6,
      "WindowSeconds": 60
    },
    "Download": {
      "PermitLimit": 12,
      "WindowSeconds": 60
    }
  },
  "OpenRouteService": {
    "BaseUrl": "https://api.openrouteservice.org"
  }
}
